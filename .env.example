# SQLite Database path (optional, default is data/gcc_atlas.sqlite or /data/gcc_atlas.sqlite in Docker)
GCC_ATLAS_DB=data/gcc_atlas.sqlite

# Review Token (optional, protects review mutations over the API if enabled)
# GCC_ATLAS_REVIEW_TOKEN=your-secret-review-token-here

# Server host and port (for uvicorn)
HOST=0.0.0.0
PORT=8000
